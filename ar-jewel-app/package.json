{
  "name": "ar-jewel-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-mediapipe.mjs",
    "dev": "vite --host",
    "api": "node server/server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node server/server.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests e2e scripts",
    "e2e": "playwright test",
    "check:glb": "node scripts/check-glb.mjs",
    "optimize:glb": "node scripts/optimize-glb.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "postprocessing": "^6.39.5",
    "qrcode": "^1.5.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.170.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
